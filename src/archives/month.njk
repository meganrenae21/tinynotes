---
pagination: 
  data: collections.PostsByYearMonth
  size: 1
  alias: archives
permalink: "/archives/{{ archives.year }}/{{ archives.month | lower | slug }}/"
layout: base.njk
---

<h4 class="article-head">{{ archives.month }} {{ archives.year }}</h4>
<ul class="index">
{% for note in archives.notes %}
    <li><span class="index-title"><span class="index-date">{{ note.data.date | shortDate }}</span> - <a href={{ note.url }}>{{ note.data.title }}</a></span><span class="index-tags">{% for tag in note.data.tags %}<a class="index-tag-link" href="/tags/{{ tag }}/">{{ tag }}</a> {% endfor %}</span></li>
{% endfor %}
</ul>