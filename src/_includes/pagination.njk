<nav role="navigation" class="pagination" aria-label="pagination">
    {% if page.url != pagination.href.first %}<a href="{{ pagination.href.first }}" class="page-first">&lt;&lt; First</a>{% else %}<span class="strikethrough">&lt;&lt; First</span>{% endif %}
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" class="page-prev">Previous</a>{% else %}<span class="strikethrough">&lt; Previous</span>{% endif %}
    {%- for pageEntry in pagination.pages %}
    <a href="{{ pagination.hrefs[ loop.index0 ] }}"{% if page.url == pagination.hrefs[ loop.index0 ] %} aria-current="page" class="page-cur"{% endif %}>{{ loop.index }}</a>
{%- endfor %}
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}" class="page-next">Next &gt;</a>{% else %}<span class="strikethrough">Next &gt;</span>{% endif %}
    {% if page.url != pagination.href.last %}<a href="{{ pagination.href.last }}" class="page-last">Last &gt;&gt;</a>{% else %}<span class="strikethrough">Last &gt;&gt;</span>{% endif %}
</nav>